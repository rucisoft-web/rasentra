APP_NAME=Rasentra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rasentra
DB_USERNAME=rasentra
DB_PASSWORD=

# Profil instalasi: lokal (Rasentra Lokal, server outlet) atau central (Rasentra Central + Core, kantor pusat)
RASENTRA_PROFILE=lokal
RASENTRA_SOURCE_ID=SRV-SLO
RASENTRA_OUTLET_CODE=SLO
RASENTRA_CENTRAL_URL=https://central.indoguna.local
RASENTRA_CENTRAL_TOKEN=
RASENTRA_VERSION=1.0.0
RASENTRA_ROUNDING=HALF_UP

# SAP B1 Service Layer (hanya profil central). Nilai bawaan dipakai semua instance,
# lalu ditimpa per database SAP: sap_solo (CV Solo Kulina Utama), sap_lombok (CV Lombok Kulina Utama).
SAP_SL_URL=
SAP_USERNAME=
SAP_PASSWORD=
SAP_SOLO_SL_URL=
SAP_SOLO_USERNAME=
SAP_SOLO_PASSWORD=
SAP_LOMBOK_SL_URL=
SAP_LOMBOK_USERNAME=
SAP_LOMBOK_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
